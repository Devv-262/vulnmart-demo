<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>VulnMart — Checkout</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; margin: 0; background: #f6f5f2; color: #1a1a1a; }
    .wrap { padding: 28px 32px; max-width: 460px; }
    .line { display: flex; align-items: center; gap: 12px; background: white; border-radius: 10px; padding: 10px 12px; margin-bottom: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .line img { width: 44px; height: 44px; object-fit: cover; border-radius: 6px; background: #eee; }
    .line-info { flex: 1; font-size: 13.5px; font-weight: 600; }
    .line-total { font-weight: 700; font-size: 13.5px; }
    form.checkout-form { background: white; border-radius: 10px; padding: 18px; margin-top: 16px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    label { display: block; font-size: 13px; color: #555; margin: 10px 0 4px; font-weight: 600; }
    input { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 14px; }
    button { margin-top: 18px; padding: 11px 20px; background: #2a5; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; font-weight: 700; width: 100%; }
    button:hover { background: #1f7a3d; }
  </style>
</head>
<body>
  <%- include('_layout-top', {active: 'cart', userName}) %>
  <div class="wrap">
    <h2>Checkout</h2>
    <% lines.forEach(function(l) { %>
      <div class="line">
        <img src="<%= l.product.image_url %>" alt="<%= l.product.name %>">
        <div class="line-info"><%= l.product.name %> × <%= l.qty %></div>
        <div class="line-total">$<%= l.lineTotal.toFixed(2) %></div>
      </div>
    <% }); %>
    <form class="checkout-form" action="/checkout" method="POST">
      <label for="total">Order Total ($)</label>
      <input type="number" step="0.01" id="total" name="total" value="<%= subtotal.toFixed(2) %>">

      <label for="coupon1">Promo Code 1</label>
      <input type="text" id="coupon1" name="coupon1" placeholder="Optional">

      <label for="coupon2">Promo Code 2</label>
      <input type="text" id="coupon2" name="coupon2" placeholder="Optional — apply a second code">

      <button type="submit" id="checkoutBtn">Place Order</button>
    </form>
  </div>
</body>
</html>
