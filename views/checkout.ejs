<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>VulnMart — Checkout</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #faf8f4; }
    .wrap { padding: 24px; max-width: 420px; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; margin-bottom: 16px; }
    td, th { padding: 10px 12px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }
    label { display: block; font-size: 13px; color: #555; margin: 10px 0 4px; }
    input { width: 100%; padding: 9px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 14px; }
    button { margin-top: 16px; padding: 10px 18px; background: #2a5; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; }
  </style>
</head>
<body>
  <%- include('_layout-top', {active: 'cart', userName}) %>
  <div class="wrap">
    <h2>Checkout</h2>
    <table>
      <tr><th>Item</th><th>Qty</th><th>Price</th></tr>
      <% lines.forEach(function(l) { %>
        <tr><td><%= l.product.name %></td><td><%= l.qty %></td><td>$<%= l.lineTotal.toFixed(2) %></td></tr>
      <% }); %>
    </table>
    <form action="/checkout" method="POST">
      <label for="total">Order Total ($)</label>
      <input type="number" step="0.01" id="total" name="total" value="<%= subtotal.toFixed(2) %>">

      <label for="coupon1">Promo Code 1</label>
      <input type="text" id="coupon1" name="coupon1" placeholder="Optional">

      <label for="coupon2">Promo Code 2</label>
      <input type="text" id="coupon2" name="coupon2" placeholder="Optional — apply a second code">

      <button type="submit" id="checkoutBtn">Place Order</button>
    </form>
  </div>
</body>
</html>
