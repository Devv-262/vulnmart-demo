<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>VulnMart — Login</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f1ea; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
    .card { background: white; padding: 32px; border-radius: 12px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); width: 320px; }
    h1 { font-size: 20px; margin: 0 0 6px; }
    .sub { color: #777; font-size: 13px; margin-bottom: 20px; }
    input { width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-size: 14px; }
    button { width: 100%; padding: 10px; background: #2a5; color: white; border: none; border-radius: 6px; font-size: 14px; cursor: pointer; }
    .error { color: #c0392b; font-size: 13px; margin-bottom: 12px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>🛒 VulnMart</h1>
    <div class="sub">Sign in to continue</div>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form action="/login" method="POST">
      <input type="text" id="email" name="email" placeholder="Email" autocomplete="off">
      <input type="password" id="password" name="password" placeholder="Password">
      <button type="submit" id="loginBtn">Log In</button>
    </form>
  </div>
</body>
</html>
