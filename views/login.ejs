<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>VulnMart — Login</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; background: linear-gradient(135deg, #1b3a2f, #2a5); display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
    .card { background: white; padding: 32px; border-radius: 14px; box-shadow: 0 20px 50px rgba(0,0,0,0.25); width: 320px; }
    .logo { font-size: 22px; font-weight: 800; margin-bottom: 2px; }
    h1 { font-size: 15px; font-weight: 600; margin: 0 0 6px; color: #444; }
    .sub { color: #888; font-size: 13px; margin-bottom: 20px; }
    input { width: 100%; padding: 10px; margin-bottom: 12px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 14px; }
    button { width: 100%; padding: 11px; background: #2a5; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer; }
    button:hover { background: #1f7a3d; }
    .error { color: #c0392b; font-size: 13px; margin-bottom: 12px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">🛒 VulnMart</div>
    <h1>Electronics, deals you can trust*</h1>
    <div class="sub">Sign in to continue</div>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form action="/login" method="POST">
      <input type="text" id="email" name="email" placeholder="Email" autocomplete="off">
      <input type="password" id="password" name="password" placeholder="Password">
      <button type="submit" id="loginBtn">Log In</button>
    </form>
  </div>
</body>
</html>
