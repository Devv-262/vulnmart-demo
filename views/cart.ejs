<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>VulnMart — Cart</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: system-ui, -apple-system, sans-serif; margin: 0; background: #f6f5f2; color: #1a1a1a; }
    .wrap { padding: 28px 32px; max-width: 560px; }
    .line { display: flex; align-items: center; gap: 14px; background: white; border-radius: 10px; padding: 12px; margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .line img { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; background: #eee; }
    .line-info { flex: 1; }
    .line-info .name { font-size: 14px; font-weight: 600; }
    .line-info .qty { font-size: 12.5px; color: #777; }
    .line-total { font-weight: 700; font-size: 14px; }
    .total { font-weight: 700; font-size: 18px; margin: 18px 0; }
    a.btn { display: inline-block; padding: 11px 20px; background: #2a5; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; }
    a.btn:hover { background: #1f7a3d; }
  </style>
</head>
<body>
  <%- include('_layout-top', {active: 'cart', userName}) %>
  <div class="wrap">
    <h2>Your Cart</h2>
    <% lines.forEach(function(l) { %>
      <div class="line">
        <img src="<%= l.product.image_url %>" alt="<%= l.product.name %>">
        <div class="line-info">
          <div class="name"><%= l.product.name %></div>
          <div class="qty">Qty: <%= l.qty %></div>
        </div>
        <div class="line-total">$<%= l.lineTotal.toFixed(2) %></div>
      </div>
    <% }); %>
    <div class="total">Subtotal: $<%= subtotal.toFixed(2) %></div>
    <a class="btn" href="/checkout">Proceed to Checkout</a>
  </div>
</body>
</html>
