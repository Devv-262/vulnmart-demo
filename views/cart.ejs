<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>VulnMart — Cart</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #faf8f4; }
    .wrap { padding: 24px; max-width: 480px; }
    table { width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; }
    td, th { padding: 10px 12px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }
    .total { font-weight: 700; font-size: 16px; margin: 16px 0; }
    a.btn { display: inline-block; padding: 10px 18px; background: #2a5; color: white; border-radius: 6px; text-decoration: none; }
  </style>
</head>
<body>
  <%- include('_layout-top', {active: 'cart', userName}) %>
  <div class="wrap">
    <h2>Your Cart</h2>
    <table>
      <tr><th>Item</th><th>Qty</th><th>Price</th></tr>
      <% lines.forEach(function(l) { %>
        <tr><td><%= l.product.name %></td><td><%= l.qty %></td><td>$<%= l.lineTotal.toFixed(2) %></td></tr>
      <% }); %>
    </table>
    <div class="total">Subtotal: $<%= subtotal.toFixed(2) %></div>
    <a class="btn" href="/checkout">Proceed to Checkout</a>
  </div>
</body>
</html>
