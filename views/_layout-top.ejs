  <div style="font-weight:700;">🛒 VulnMart</div>
  <div style="font-size:14px;display:flex;gap:16px;align-items:center;">
    <a href="/products" style="color:white;text-decoration:<%= active==='products'?'underline':'none' %>;">Products</a>
